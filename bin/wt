#!/bin/bash

# Git Worktree Helper - A tool for managing Git worktrees with ease
# Version: 1.0.0

# Helper function to get the main project directory regardless of current location
# Sets: PROJECT_DIR (main project), CURRENT_IS_WORKTREE (true/false), WORKTREE_PARENT (WT folder path)
detect_project_context() {
    local current_git_dir
    current_git_dir=$(git rev-parse --show-toplevel 2>/dev/null)
    if [ $? -ne 0 ]; then
        echo "❌ ERROR: Not in a Git repository"
        exit 1
    fi

    # Check if current directory is a worktree using git worktree list
    local worktree_info=$(git worktree list --porcelain 2>/dev/null)
    local main_worktree=$(echo "$worktree_info" | grep -A1 "^worktree " | head -2 | tail -1 | sed 's/^worktree //')

    # First worktree in the list is always the main one
    main_worktree=$(echo "$worktree_info" | grep "^worktree " | head -1 | sed 's/^worktree //')

    if [ "$current_git_dir" = "$main_worktree" ]; then
        # We're in the main project
        PROJECT_DIR="$current_git_dir"
        CURRENT_IS_WORKTREE=false
    else
        # We're in a worktree, use the main worktree as project dir
        PROJECT_DIR="$main_worktree"
        CURRENT_IS_WORKTREE=true
    fi

    # Define the worktree parent folder
    local project_name=$(basename "$PROJECT_DIR")
    WORKTREE_PARENT="$(dirname "$PROJECT_DIR")/WT/${project_name}"
}

# Function to show help
show_help() {
    echo "Git Worktree Helper - Manage Git worktrees with ease"
    echo ""
    echo "USAGE:"
    echo "  wt <feature-name>              Create a new worktree and branch"
    echo "  wt stop                        Stop servers in current worktree"
    echo "  wt remove <feature-name>       Remove worktree and stop servers"
    echo "  wt merge <feature-name> [branch] Merge and cleanup worktree (default: main)"
    echo "  wt logs [feature-name]         View Rails logs for worktree"
    echo "  wt webpack-logs [feature-name] View Webpack logs for worktree"
    echo "  wt list                        List all running worktree servers"
    echo "  wt cleanup-all                 Remove ALL worktrees and stop servers"
    echo "  wt --help, -h                  Show this help message"
    echo "  wt --version, -v               Show version information"
    echo ""
    echo "EXAMPLES:"
    echo "  wt feature-login               Create worktree for 'feature-login'"
    echo "  wt remove feature-login        Remove the 'feature-login' worktree"
    echo "  wt merge feature-login main    Merge into 'main' branch"
}

# Function to show version
show_version() {
    echo "Git Worktree Helper v1.0.0"
    echo "A tool for managing Git worktrees with automatic server setup"
}

# Function to stop servers for a specific worktree (without removing the worktree)
# Arguments: worktree_path, feature_name
stop_worktree_servers() {
    local worktree_path="$1"
    local feature_name="$2"

    # Stop Rails server with multiple fallback strategies
    local rails_stopped=false
    if [ -f "$worktree_path/tmp/.rails_pid" ]; then
        local rails_pid=$(cat "$worktree_path/tmp/.rails_pid")
        if kill -0 "$rails_pid" 2>/dev/null; then
            kill "$rails_pid"
            echo "🚂 Stopped Rails server (PID: $rails_pid)"
            rails_stopped=true
        fi
    fi

    # Fallback: find Rails server by port if PID method failed
    if [ ! "$rails_stopped" = true ] && [ -f "$worktree_path/tmp/.rails_port" ]; then
        local rails_port=$(cat "$worktree_path/tmp/.rails_port")
        local rails_pid=$(lsof -ti tcp:$rails_port 2>/dev/null)
        if [ -n "$rails_pid" ]; then
            kill "$rails_pid"
            echo "🚂 Stopped Rails server on port $rails_port (PID: $rails_pid)"
            rails_stopped=true
        fi
    fi

    # Final fallback: find Rails/Puma processes by worktree name
    if [ ! "$rails_stopped" = true ]; then
        local puma_pids=$(ps aux | grep "puma.*\[$feature_name\]" | grep -v grep | awk '{print $2}')
        if [ -n "$puma_pids" ]; then
            echo "$puma_pids" | xargs kill
            echo "🚂 Stopped Rails server processes: $puma_pids"
        fi
    fi

    # Stop Webpack dev server with multiple fallback strategies
    local webpack_stopped=false
    if [ -f "$worktree_path/tmp/.webpack_pid" ]; then
        local webpack_pid=$(cat "$worktree_path/tmp/.webpack_pid")
        if kill -0 "$webpack_pid" 2>/dev/null; then
            kill "$webpack_pid"
            echo "📦 Stopped Webpack dev server (PID: $webpack_pid)"
            webpack_stopped=true
        fi
    fi

    # Fallback: find Webpack server by port if PID method failed
    if [ ! "$webpack_stopped" = true ] && [ -f "$worktree_path/tmp/.webpack_port" ]; then
        local webpack_port=$(cat "$worktree_path/tmp/.webpack_port")
        local webpack_pid=$(lsof -ti tcp:$webpack_port 2>/dev/null)
        if [ -n "$webpack_pid" ]; then
            kill "$webpack_pid"
            echo "📦 Stopped Webpack dev server on port $webpack_port (PID: $webpack_pid)"
            webpack_stopped=true
        fi
    fi

    # Final fallback: find webpack-dev-server processes by worktree path
    if [ ! "$webpack_stopped" = true ]; then
        local webpack_pids=$(ps aux | grep "webpack-dev-server.*$worktree_path" | grep -v grep | awk '{print $2}')
        if [ -n "$webpack_pids" ]; then
            echo "$webpack_pids" | xargs kill
            echo "📦 Stopped Webpack dev server processes: $webpack_pids"
        fi
    fi

    # Clean up PID and port files
    rm -f "$worktree_path/tmp/.rails_pid" 2>/dev/null
    rm -f "$worktree_path/tmp/.rails_port" 2>/dev/null
    rm -f "$worktree_path/tmp/.webpack_pid" 2>/dev/null
    rm -f "$worktree_path/tmp/.webpack_port" 2>/dev/null
}

# Function to offer branch deletion after merge (when worktree is kept)
# Arguments: project_dir, feature_name
offer_branch_deletion() {
    local project_dir="$1"
    local feature_name="$2"

    # Check if branch has any unique commits compared to main
    local main_branch=$(git -C "$project_dir" symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@')
    if [ -z "$main_branch" ]; then
        main_branch="main"
    fi

    # Count commits that are in feature branch but not in main branch
    local unique_commits=$(git -C "$project_dir" rev-list --count "${main_branch}..${feature_name}" 2>/dev/null || echo "0")

    if [ "$unique_commits" -eq 0 ]; then
        # No unique commits, auto-delete without asking
        git -C "$project_dir" branch -D "$feature_name" 2>/dev/null
        echo "🗑️  Auto-deleted branch '$feature_name' (no unique commits)"
    else
        # Has unique commits, ask user
        echo "⚠️  Branch '$feature_name' has $unique_commits unique commit(s)"
        echo -n "🗑️  Delete branch '$feature_name'? (y/N): "
        read -r REPLY </dev/tty
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            git -C "$project_dir" branch -D "$feature_name"
            echo "🗑️  Deleted branch '$feature_name'"
        else
            echo "⏭️  Keeping branch '$feature_name'"
        fi
    fi
}

# Function to close RubyMine window for a specific worktree
close_rubymine_window() {
    local feature_name="$1"
    if [ -z "$feature_name" ]; then
        return
    fi

    echo "🔧 Closing RubyMine windows for '$feature_name'..."
    if command -v osascript >/dev/null 2>&1; then
        # Get all RubyMine window names
        local windows=$(osascript -e "tell application \"System Events\" to tell process \"RubyMine\" to get name of every window" 2>/dev/null)

        if [ $? -eq 0 ] && [ -n "$windows" ]; then
            # Check if any window contains the feature name
            local found_window=false

            # Split windows by comma and check each one
            IFS=',' read -ra WINDOW_ARRAY <<< "$windows"
            for window in "${WINDOW_ARRAY[@]}"; do
                # Trim whitespace
                window=$(echo "$window" | xargs)
                if [[ "$window" == *"$feature_name"* ]]; then
                    found_window=true
                    echo "🎯 Found matching window: $window"
                    # Close this specific window by clicking its close button
                    osascript -e "tell application \"System Events\" to tell process \"RubyMine\" to click button 1 of window \"$window\"" 2>/dev/null
                    sleep 0.3  # Brief pause to allow window to close
                fi
            done

            if [ "$found_window" = true ]; then
                echo "✅ RubyMine window(s) closed"
            else
                echo "⚠️  No RubyMine window found containing '$feature_name'"
            fi
        else
            echo "⚠️  RubyMine not running or no windows found"
        fi
    else
        echo "⚠️  AppleScript not available, skipping window close"
    fi
}

# Main worktree creation function
create_worktree() {
    local feature_name="$1"

    # Fail fast if no feature name was provided
    if [ -z "$feature_name" ]; then
        echo "❌ Usage: wt <feature-name>"
        exit 1
    fi

    # Detect project context (works from main or any worktree)
    detect_project_context
    local project_dir="$PROJECT_DIR"
    local worktree_parent="$WORKTREE_PARENT"

    if [ "$CURRENT_IS_WORKTREE" = true ]; then
        echo "🔍 Running from worktree, using main project: $project_dir"
    fi

    # Verify the main project directory exists
    if [ ! -d "$project_dir" ]; then
        echo "❌ ERROR: Main project directory not found: $project_dir"
        exit 1
    fi

    # Get the base name of the current project folder
    local project_name=$(basename "$project_dir")

    # Define the full path of the new worktree folder
    local worktree_path="${worktree_parent}/${feature_name}"

    # Create the parent worktrees folder if it doesn't exist
    if ! mkdir -p "$worktree_parent"; then
        echo "❌ ERROR: Failed to create worktree parent directory"
        exit 1
    fi

    # Create the worktree and the branch
    if ! git -C "$project_dir" worktree add -b "$feature_name" "$worktree_path"; then
        echo "❌ ERROR: Failed to create worktree"
        exit 1
    fi

    # Copy .env if it exists
    if [ -f "$project_dir/.env" ]; then
        if cp "$project_dir/.env" "$worktree_path/.env"; then
            echo "📋 Copied .env into worktree."
        else
            echo "⚠️  WARNING: Failed to copy .env file"
        fi
    fi

    # Copy Rails credentials if they exist
    if [ -f "$project_dir/config/credentials.yml.enc" ]; then
        if cp "$project_dir/config/credentials.yml.enc" "$worktree_path/config/credentials.yml.enc"; then
            echo "🔐 Copied credentials.yml.enc into worktree."
        else
            echo "⚠️  WARNING: Failed to copy credentials.yml.enc"
        fi
    fi

    if [ -f "$project_dir/config/master.key" ]; then
        if cp "$project_dir/config/master.key" "$worktree_path/config/master.key"; then
            echo "🔑 Copied master.key into worktree."
        else
            echo "⚠️  WARNING: Failed to copy master.key"
        fi
    fi

    # List of hidden folders to copy if they exist (ONLY from main project)
    local hidden_dirs=(.github .idea .vscode)

    for dir in "${hidden_dirs[@]}"; do
        if [ -d "$project_dir/$dir" ]; then
            # Create the destination directory first, then copy contents
            if mkdir -p "$worktree_path/$dir" && cp -R "$project_dir/$dir/"* "$worktree_path/$dir/"; then
                echo "📁 Copied $dir into worktree."
            else
                echo "⚠️  WARNING: Failed to copy $dir"
            fi
        fi
    done

    # cd into the new worktree
    if ! cd "$worktree_path"; then
        echo "❌ ERROR: Failed to change to worktree directory"
        exit 1
    fi

    # Open the worktree in RubyMine immediately
    echo "💻 Opening worktree in RubyMine..."
    if [ -f "/Applications/RubyMine.app/Contents/MacOS/rubymine" ]; then
        "/Applications/RubyMine.app/Contents/MacOS/rubymine" "$worktree_path" &
    else
        echo "⚠️  WARNING: RubyMine not found, skipping IDE launch"
    fi

    # Install dependencies if this is a Rails project
    if [ -f "$worktree_path/Gemfile" ]; then
        echo "💎 Installing Ruby gems..."
        if bundle install --quiet; then
            echo "✅ Ruby gems installed successfully"
        else
            echo "⚠️  WARNING: Failed to install Ruby gems (continuing anyway)"
        fi
    fi

    if [ -f "$worktree_path/package.json" ] || [ -f "$worktree_path/yarn.lock" ]; then
        echo "📦 Installing Node.js dependencies..."
        if yarn install --silent; then
            echo "✅ Node.js dependencies installed successfully"
        else
            echo "⚠️  WARNING: Failed to install Node.js dependencies (continuing anyway)"
        fi
    fi

    # Find next available port for Rails (starting from 3001)
    local rails_port=3001
    while lsof -ti tcp:$rails_port >/dev/null 2>&1; do
        rails_port=$((rails_port + 1))
    done

    # Check if this is a Rails project
    if [ -f "$worktree_path/bin/rails" ]; then
        echo "🚂 Starting Rails server on port $rails_port..."
        # Create tmp directory if it doesn't exist
        mkdir -p tmp
        # Start Rails server in background with proper PID capture
        bin/rails server -p $rails_port > tmp/rails.log 2>&1 &
        local rails_pid=$!

        # Wait a moment and verify the process is actually running
        sleep 1
        if kill -0 "$rails_pid" 2>/dev/null; then
            echo "Rails server started with PID $rails_pid on http://localhost:$rails_port"
            echo "$rails_pid" > tmp/.rails_pid
            echo "$rails_port" > tmp/.rails_port
            echo "📋 To view Rails logs in real-time: tail -f tmp/rails.log"
            echo "📋 To view Rails logs from worktree: wt logs $feature_name"
        else
            echo "⚠️  WARNING: Failed to start Rails server (check tmp/rails.log for details)"
        fi
    fi

    # Check if this has Webpack dev server
    if [ -f "$worktree_path/bin/webpack-dev-server" ]; then
        # Find next available port for Webpack (starting from 3036)
        local webpack_port=3036
        while lsof -ti tcp:$webpack_port >/dev/null 2>&1; do
            webpack_port=$((webpack_port + 1))
        done
        echo "📦 Starting Webpack dev server on port $webpack_port..."

        # Update webpacker.yml to use the unique port (if it exists)
        if [ -f "$worktree_path/config/webpacker.yml" ]; then
            sed -i '' "s/port: 3035/port: $webpack_port/g" config/webpacker.yml
            sed -i '' "s/public: localhost:3035/public: localhost:$webpack_port/g" config/webpacker.yml
            # Mark the file to be skipped by git to prevent accidental commits
            git update-index --skip-worktree config/webpacker.yml
            echo "🔧 Updated webpacker.yml to use port $webpack_port"
        fi

        # Start Webpack dev server (port is configured in webpacker.yml)
        bin/webpack-dev-server > tmp/webpack.log 2>&1 &
        local webpack_pid=$!

        # Wait a moment and verify the process is actually running
        sleep 1
        if kill -0 "$webpack_pid" 2>/dev/null; then
            echo "✅ Webpack dev server started with PID $webpack_pid on port $webpack_port"
            echo "$webpack_pid" > tmp/.webpack_pid
            echo "$webpack_port" > tmp/.webpack_port
        else
            echo "⚠️  WARNING: Failed to start Webpack dev server (check tmp/webpack.log for details)"
        fi

        # Wait for Webpack to compile before opening browser
        if [ -f "$worktree_path/bin/rails" ]; then
            echo "⏳ Waiting for Webpack dev server to be ready..."

            # Configuration
            local max_timeout=180  # Maximum wait time in seconds
            local timeout=$max_timeout
            local last_progress=""
            local check_interval=2
            local webpack_ready=false

            while [ $timeout -gt 0 ]; do
                # Primary check: Is webpack dev server responding on its port?
                local http_code=$(curl -s -o /dev/null -w "%{http_code}" "http://localhost:$webpack_port" 2>/dev/null)
                if [[ "$http_code" =~ ^(200|404|302)$ ]]; then
                    echo "✅ Webpack dev server is ready!"
                    webpack_ready=true
                    break
                fi

                # Error detection: Check for compilation failures in logs
                if grep -q "Failed to compile\|ERROR in\|Module not found" tmp/webpack.log 2>/dev/null; then
                    echo "❌ Webpack compilation failed! Check tmp/webpack.log for errors:"
                    echo "   tail -f tmp/webpack.log"
                    echo "   wt logs $feature_name (for Rails logs)"
                    break
                fi

                # Progress-based timeout extension: Reset if progress is being made
                local current_progress=$(grep -o "\[webpack\.Progress\] [0-9]*%" tmp/webpack.log 2>/dev/null | tail -1)
                if [ -n "$current_progress" ] && [ "$current_progress" != "$last_progress" ]; then
                    # Progress detected, extend timeout (but not beyond max)
                    if [ $timeout -lt 60 ]; then
                        timeout=60
                        echo "📊 Progress detected ($current_progress), extending timeout..."
                    fi
                    last_progress="$current_progress"
                fi

                sleep $check_interval
                timeout=$((timeout - check_interval))
            done

            # Check if we timed out
            if [ $timeout -le 0 ]; then
                echo "⚠️  Webpack compilation timeout (${max_timeout}s). Check tmp/webpack.log:"
                echo "   tail -f tmp/webpack.log"
            fi

            # Test if Rails server is responding (give it more time since it's starting in new terminal)
            echo "🔍 Waiting for Rails server to start and testing connection..."
            sleep 3  # Give Rails extra time to start in the new terminal
            for i in {1..15}; do
                if curl -s -o /dev/null -w "%{http_code}" "http://localhost:$rails_port" 2>/dev/null | grep -q "200"; then
                    echo "✅ Rails server is responding!"
                    if command -v open >/dev/null 2>&1; then
                        (sleep 2 && open "http://localhost:$rails_port" 2>/dev/null) &
                        echo "🌐 Opening http://localhost:$rails_port in browser..."
                    fi
                    break
                fi
                echo "⏳ Attempt $i/15 - Rails server not ready yet..."
                sleep 2
            done
        fi
    fi

    # Confirm success
    echo "✅ Worktree '$feature_name' created at $worktree_path and checked out."

    if [ -f "$worktree_path/bin/rails" ]; then
        echo "🌐 Rails app available at: http://localhost:$rails_port"
    fi
}

# Function to stop servers in current worktree
stop_servers() {
    echo "🛑 Stopping servers in current worktree..."

    # Stop Rails server if running
    if [ -f "tmp/.rails_pid" ]; then
        local rails_pid=$(cat tmp/.rails_pid)
        if kill -0 "$rails_pid" 2>/dev/null; then
            kill "$rails_pid"
            echo "🚂 Stopped Rails server (PID: $rails_pid)"
        fi
        rm tmp/.rails_pid
    fi

    # Stop Webpack dev server if running
    if [ -f "tmp/.webpack_pid" ]; then
        local webpack_pid=$(cat tmp/.webpack_pid)
        if kill -0 "$webpack_pid" 2>/dev/null; then
            kill "$webpack_pid"
            echo "📦 Stopped Webpack dev server (PID: $webpack_pid)"
        fi
        rm tmp/.webpack_pid
        [ -f "tmp/.webpack_port" ] && rm tmp/.webpack_port
    fi

    echo "✅ All servers stopped."
}

# Function to view Rails logs for a specific worktree
view_logs() {
    local feature_name="$1"

    # If no feature name provided, try to detect from current directory
    if [ -z "$feature_name" ]; then
        local current_dir=$(pwd)
        if [[ "$current_dir" == *"/WT/"* ]]; then
            feature_name=$(basename "$current_dir")
            echo "📋 Auto-detected feature: $feature_name"
        else
            echo "❌ Usage: wt logs <feature-name>"
            echo "   Or run from within a worktree directory (path must contain '/WT/')"
            exit 1
        fi
    fi

    # Get the current Git project directory
    local git_toplevel=$(git rev-parse --show-toplevel 2>/dev/null)
    if [ $? -ne 0 ]; then
        echo "❌ Not in a Git repository"
        exit 1
    fi

    # Check if we're already in a worktree or in the main project
    local worktree_path
    if [[ "$git_toplevel" == */WT/* ]]; then
        # We're inside a worktree, use the current path
        worktree_path="$git_toplevel"
    else
        # We're in the main project, construct the worktree path
        local project_name=$(basename "$git_toplevel")
        local worktree_parent="$(dirname "$git_toplevel")/WT/${project_name}"
        worktree_path="${worktree_parent}/${feature_name}"
    fi

    # Check if worktree exists
    if [ ! -d "$worktree_path" ]; then
        echo "❌ Worktree '$feature_name' not found at $worktree_path"
        exit 1
    fi

    # Check if Rails log exists
    if [ ! -f "$worktree_path/tmp/rails.log" ]; then
        echo "❌ No Rails log found for '$feature_name'"
        echo "   Expected: $worktree_path/tmp/rails.log"
        exit 1
    fi

    echo "📋 Viewing Rails logs for '$feature_name' (Ctrl+C to exit)"
    echo "🔗 Log file: $worktree_path/tmp/rails.log"
    echo ""
    tail -f "$worktree_path/tmp/rails.log"
}

# Function to view Webpack logs for a specific worktree
view_webpack_logs() {
    local feature_name="$1"

    # If no feature name provided, try to detect from current directory
    if [ -z "$feature_name" ]; then
        local current_dir=$(pwd)
        if [[ "$current_dir" == *"/WT/"* ]]; then
            feature_name=$(basename "$current_dir")
            echo "📋 Auto-detected feature: $feature_name"
        else
            echo "❌ Usage: wt webpack-logs <feature-name>"
            echo "   Or run from within a worktree directory (path must contain '/WT/')"
            exit 1
        fi
    fi

    # Get the current Git project directory
    local git_toplevel=$(git rev-parse --show-toplevel 2>/dev/null)
    if [ $? -ne 0 ]; then
        echo "❌ Not in a Git repository"
        exit 1
    fi

    # Check if we're already in a worktree or in the main project
    local worktree_path
    if [[ "$git_toplevel" == */WT/* ]]; then
        # We're inside a worktree, use the current path
        worktree_path="$git_toplevel"
    else
        # We're in the main project, construct the worktree path
        local project_name=$(basename "$git_toplevel")
        local worktree_parent="$(dirname "$git_toplevel")/WT/${project_name}"
        worktree_path="${worktree_parent}/${feature_name}"
    fi

    # Check if worktree exists
    if [ ! -d "$worktree_path" ]; then
        echo "❌ Worktree '$feature_name' not found at $worktree_path"
        exit 1
    fi

    # Check if Webpack log exists
    if [ ! -f "$worktree_path/tmp/webpack.log" ]; then
        echo "❌ No Webpack log found for '$feature_name'"
        echo "   Expected: $worktree_path/tmp/webpack.log"
        exit 1
    fi

    echo "📦 Viewing Webpack logs for '$feature_name' (Ctrl+C to exit)"
    echo "🔗 Log file: $worktree_path/tmp/webpack.log"
    echo ""
    tail -f "$worktree_path/tmp/webpack.log"
}

# Function to list all running Rails servers from worktrees
list_servers() {
    echo "📋 Active worktree servers:"
    echo ""

    # Find all Rails servers with their directories and ports
    local rails_processes=$(ps aux | grep "rails server" | grep -v grep)

    if [ -z "$rails_processes" ]; then
        echo "   No Rails servers currently running"
    else
        echo "🚂 Rails Servers:"
        echo "$rails_processes" | while read line; do
            local pid=$(echo "$line" | awk '{print $2}')
            local port=$(echo "$line" | grep -o "\-p [0-9]*" | cut -d' ' -f2)
            local dir=$(echo "$line" | grep -o "/[^[:space:]]*/WT/[^[:space:]]*" | head -1)

            if [ -n "$dir" ]; then
                local feature_name=$(basename "$dir")
                echo "   • $feature_name - PID: $pid - Port: $port - http://localhost:$port"
            fi
        done
    fi

    echo ""
    echo "📦 Webpack Servers:"
    local webpack_processes=$(ps aux | grep "webpack-dev-server" | grep "/WT/" | grep -v grep)
    if [ -z "$webpack_processes" ]; then
        echo "   No Webpack dev servers currently running"
    else
        echo "$webpack_processes" | while read line; do
            local pid=$(echo "$line" | awk '{print $2}')
            local dir=$(echo "$line" | grep -o "/[^[:space:]]*/WT/[^[:space:]]*" | head -1)

            if [ -n "$dir" ]; then
                local feature_name=$(basename "$dir")
                echo "   • $feature_name - PID: $pid"
            fi
        done
    fi
}

# Function to remove worktree and stop servers
remove_worktree() {
    local feature_name="$1"

    # Fail fast if no feature name was provided
    if [ -z "$feature_name" ]; then
        echo "❌ Usage: wt remove <feature-name>"
        exit 1
    fi

    # Detect project context (works from main or any worktree)
    detect_project_context
    local project_dir="$PROJECT_DIR"
    local worktree_parent="$WORKTREE_PARENT"
    local worktree_path="${worktree_parent}/${feature_name}"

    if [ "$CURRENT_IS_WORKTREE" = true ]; then
        echo "🔍 Running from worktree, using main project: $project_dir"
    fi

    # Check if worktree exists
    if [ ! -d "$worktree_path" ]; then
        echo "❌ Worktree '$feature_name' not found at $worktree_path"
        exit 1
    fi

    echo "🧹 Cleaning up worktree '$feature_name'..."

    # Stop servers for this worktree
    stop_worktree_servers "$worktree_path" "$feature_name"

    # Close RubyMine window for this worktree
    close_rubymine_window "$feature_name"

    # Wait for RubyMine to fully release file handles and clean up IDE folders
    echo "🧹 Cleaning up IDE files that might prevent removal..."
    sleep 1  # Give RubyMine time to release file handles

    # Force remove IDE folders that might have locks or open file handles
    local ide_folders=(".idea" ".vscode" ".ruby-lsp")
    for folder in "${ide_folders[@]}"; do
        if [ -d "$worktree_path/$folder" ]; then
            echo "  🗑️  Force removing $folder folder..."
            # Use chmod to ensure we can delete everything, then force remove
            chmod -R 755 "$worktree_path/$folder" 2>/dev/null
            rm -rf "$worktree_path/$folder" 2>/dev/null
            if [ ! -d "$worktree_path/$folder" ]; then
                echo "  ✅ $folder folder removed"
            else
                echo "  ⚠️  $folder folder still exists, will try during worktree removal"
            fi
        fi
    done

    # Remove the worktree
    echo "🗑️  Removing worktree..."
    if git -C "$project_dir" worktree remove "$worktree_path" --force; then
        echo "✅ Worktree removed successfully"
    else
        echo "⚠️  Git worktree remove failed, attempting manual cleanup..."
        # If git worktree remove fails, manually remove the directory
        if [ -d "$worktree_path" ]; then
            echo "🧹 Force removing directory: $worktree_path"
            rm -rf "$worktree_path"
            if [ ! -d "$worktree_path" ]; then
                echo "✅ Directory manually removed"
                # Clean up the worktree from git's tracking
                git -C "$project_dir" worktree prune
            else
                echo "❌ Failed to remove directory even with force. Manual intervention required."
                echo "   You may need to close any remaining applications using files in this directory"
                echo "   Then manually run: rm -rf \"$worktree_path\""
            fi
        fi
    fi

    # Offer branch deletion
    offer_branch_deletion "$project_dir" "$feature_name"

    echo "✅ Worktree '$feature_name' removed and servers stopped."
}

# Function to clean up ALL worktrees and servers (for testing cleanup)
cleanup_all() {
    echo "🧹 Starting comprehensive cleanup of ALL worktrees and servers..."
    echo "⚠️  This will remove ALL worktrees and stop ALL related servers!"
    echo "🛡️  Main project servers (port 3000 Rails, port 3035 Webpack) will be preserved"

    # Detect project context (works from main or any worktree)
    detect_project_context
    local project_dir="$PROJECT_DIR"
    local worktree_parent="$WORKTREE_PARENT"

    if [ "$CURRENT_IS_WORKTREE" = true ]; then
        echo "🔍 Running from worktree, using main project: $project_dir"
    fi

    # Stop Rails servers related to this project's worktrees (excluding port 3000)
    echo "🚂 Stopping worktree Rails servers (preserving port 3000)..."
    local rails_pids=$(ps aux | grep "rails server" | grep "$worktree_parent" | grep -v grep | awk '{print $2}')
    if [ -n "$rails_pids" ]; then
        for pid in $rails_pids; do
            # Check if this process is NOT using port 3000
            local port_check=$(ps -p $pid -o args= | grep -o "\-p [0-9]*" | cut -d' ' -f2)
            if [ "$port_check" != "3000" ]; then
                kill $pid 2>/dev/null && echo "  Stopped Rails server PID: $pid (port: ${port_check:-unknown})"
            else
                echo "  Preserved Rails server PID: $pid (port: 3000)"
            fi
        done
    else
        echo "  No worktree Rails servers found"
    fi

    # Stop Webpack dev servers related to this project's worktrees (excluding port 3035)
    echo "📦 Stopping worktree Webpack servers (preserving port 3035)..."
    local webpack_pids=$(ps aux | grep "webpack-dev-server" | grep "$worktree_parent" | grep -v grep | awk '{print $2}')
    if [ -n "$webpack_pids" ]; then
        for pid in $webpack_pids; do
            # Check if this process is NOT using port 3035
            local port_check=$(ps -p $pid -o args= | grep -o "\-\-port [0-9]*" | cut -d' ' -f2)
            if [ "$port_check" != "3035" ]; then
                kill $pid 2>/dev/null && echo "  Stopped Webpack server PID: $pid (port: ${port_check:-unknown})"
            else
                echo "  Preserved Webpack server PID: $pid (port: 3035)"
            fi
        done
    else
        echo "  No worktree Webpack servers found"
    fi

    echo "⏳ Waiting for servers to stop..."
    sleep 3

    # Get list of all worktrees (excluding main)
    local worktrees=$(git worktree list | grep "$worktree_parent" | awk '{print $1}' | xargs -I {} basename {})

    if [ -n "$worktrees" ]; then
        echo "🗑️ Removing worktrees and branches:"
        for worktree_path in $(git worktree list | grep "$worktree_parent" | awk '{print $1}'); do
            local branch_name=$(basename "$worktree_path")
            echo "  • $branch_name"
            # Close RubyMine window for this worktree
            close_rubymine_window "$branch_name"

            # Clean up IDE folders that might prevent removal
            local ide_folders=(".idea" ".vscode" ".ruby-lsp")
            for folder in "${ide_folders[@]}"; do
                if [ -d "$worktree_path/$folder" ]; then
                    chmod -R 755 "$worktree_path/$folder" 2>/dev/null
                    rm -rf "$worktree_path/$folder" 2>/dev/null
                fi
            done

            git worktree remove "$worktree_path" --force 2>/dev/null
            git branch -D "$branch_name" 2>/dev/null
        done
    else
        echo "  No worktrees found to remove"
    fi

    # Remove the entire worktrees directory
    if [ -d "$worktree_parent" ]; then
        echo "🧹 Removing worktrees directory: $worktree_parent"
        rm -rf "$worktree_parent"
    fi

    echo "✅ Cleanup complete! All worktrees removed and servers stopped."
}

# Function to merge and cleanup worktree
merge_worktree() {
    local feature_name="$1"
    local target_branch="${2:-main}"

    # Fail fast if no feature name was provided
    if [ -z "$feature_name" ]; then
        echo "❌ Usage: wt merge <feature-name> [target-branch]"
        echo "   Default target branch is 'main'"
        exit 1
    fi

    # Detect project context (works from main or any worktree)
    detect_project_context
    local project_dir="$PROJECT_DIR"
    local worktree_parent="$WORKTREE_PARENT"
    local worktree_path="${worktree_parent}/${feature_name}"

    if [ "$CURRENT_IS_WORKTREE" = true ]; then
        echo "🔍 Running from worktree, using main project: $project_dir"
    fi

    # Check if worktree exists
    if [ ! -d "$worktree_path" ]; then
        echo "❌ Worktree '$feature_name' not found at $worktree_path"
        exit 1
    fi

    # Check for uncommitted changes in the worktree BEFORE doing anything
    local worktree_status=$(git -C "$worktree_path" status --porcelain 2>/dev/null)
    if [ -n "$worktree_status" ]; then
        echo "❌ ERROR: Worktree '$feature_name' has uncommitted changes!"
        echo ""
        echo "Uncommitted files:"
        git -C "$worktree_path" status --short
        echo ""
        echo "Please commit or stash your changes before merging."
        echo "   cd $worktree_path"
        echo "   git add . && git commit -m 'your message'"
        echo ""
        echo "Or discard changes with: git -C \"$worktree_path\" checkout -- ."
        exit 1
    fi

    # Check for uncommitted changes in the main project
    local main_status=$(git -C "$project_dir" status --porcelain 2>/dev/null)
    if [ -n "$main_status" ]; then
        echo "❌ ERROR: Main project has uncommitted changes!"
        echo ""
        echo "Uncommitted files:"
        git -C "$project_dir" status --short
        echo ""
        echo "Please commit or stash your changes before merging."
        echo "   cd $project_dir"
        echo "   git stash"
        exit 1
    fi

    echo "🔄 Merging '$feature_name' into '$target_branch'..."

    # Switch to target branch and pull latest
    git -C "$project_dir" checkout "$target_branch"
    git -C "$project_dir" pull origin "$target_branch"

    # Cascading merge strategy for cleanest possible history:
    # 1. Try fast-forward (no merge commit needed)
    # 2. If fails, rebase feature onto target then fast-forward
    # 3. If rebase conflicts, fall back to regular merge
    local merge_success=false
    local merge_method=""

    # Try 1: Fast-forward only (cleanest - works if target hasn't advanced)
    if git -C "$project_dir" merge --ff-only "$feature_name" 2>/dev/null; then
        merge_success=true
        merge_method="fast-forward"
    else
        echo "   Fast-forward not possible, attempting rebase..."

        # Try 2: Rebase feature onto target, then fast-forward
        if git -C "$worktree_path" rebase "$target_branch" 2>/dev/null; then
            if git -C "$project_dir" merge --ff-only "$feature_name" 2>/dev/null; then
                merge_success=true
                merge_method="rebase + fast-forward"
            fi
        else
            # Rebase had conflicts, abort it
            git -C "$worktree_path" rebase --abort 2>/dev/null
            echo "   Rebase had conflicts, falling back to merge..."

            # Try 3: Regular merge (creates merge commit)
            if git -C "$project_dir" merge --no-edit "$feature_name"; then
                merge_success=true
                merge_method="merge commit"
            fi
        fi
    fi

    if [ "$merge_success" = true ]; then
        echo "✅ Successfully merged '$feature_name' into '$target_branch' ($merge_method)"

        # Ask about worktree cleanup
        echo ""
        echo -n "🧹 Remove worktree '$feature_name'? (Y/n): "
        read -r REPLY </dev/tty
        if [[ ! $REPLY =~ ^[Nn]$ ]]; then
            cd "$project_dir"
            remove_worktree "$feature_name"
        else
            echo "⏭️  Keeping worktree '$feature_name' for reference"
            echo ""
            # Still stop servers to free up ports (the feature is merged, dev servers not needed)
            echo "🛑 Stopping servers to free up ports..."
            stop_worktree_servers "$worktree_path" "$feature_name"
            echo ""
            # Offer branch deletion since it's merged
            offer_branch_deletion "$project_dir" "$feature_name"
            echo ""
            echo "📁 Worktree preserved at: $worktree_path"
            echo "   Remove later with: wt remove $feature_name"
        fi
    else
        echo "❌ Merge failed. Please resolve conflicts manually."
        echo "   After resolving, you can run: wt remove $feature_name"
        exit 1
    fi
}

# Main command dispatcher
main() {
    case "${1:-}" in
        --help|-h)
            show_help
            ;;
        --version|-v)
            show_version
            ;;
        stop)
            stop_servers
            ;;
        remove)
            remove_worktree "$2"
            ;;
        merge)
            merge_worktree "$2" "$3"
            ;;
        logs)
            view_logs "$2"
            ;;
        webpack-logs)
            view_webpack_logs "$2"
            ;;
        list)
            list_servers
            ;;
        cleanup-all)
            cleanup_all
            ;;
        "")
            echo "❌ No command provided"
            echo ""
            show_help
            exit 1
            ;;
        *)
            # Default action: create worktree
            create_worktree "$1"
            ;;
    esac
}

# Run main function with all arguments
main "$@"